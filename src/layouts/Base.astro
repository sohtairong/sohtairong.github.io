---
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { featuredOf, getTrips } from '../lib/trips';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  header?: boolean;
  /** Photo shown when the page's link is shared. Defaults to the home-page hero photo. */
  image?: ImageMetadata;
}
const about = await getEntry('about', 'about');
const name = about?.data.name ?? 'Tai Rong';
const { header = true, title, image, description = 'Travel photographs by ' + name + ', sorted by place.' } = Astro.props;
const pageTitle = title ? `${title} · ${name}` : name;

// Link preview (the card shown when the page is shared on LinkedIn, WhatsApp, Telegram…).
// Uses the page's own photo, else the hero photo, else the newest trip's first featured photo.
const newest = (await getTrips())[0];
const shareSrc = image ?? about?.data.hero ?? (newest ? featuredOf(newest)[0]?.src : undefined);
const share = shareSrc
  ? await getImage({ src: shareSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })
  : undefined;
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = abs(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Link previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {share && <meta property="og:image" content={abs(share.src)} />}
    {share && <meta property="og:image:width" content="1200" />}
    {share && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
    />
    <!-- Smooth page-to-page transitions (switches itself off for people who prefer reduced motion). -->
    <ClientRouter />
    <script is:inline>
      // Runs before the page paints, and again after every page transition,
      // so a saved light/dark choice never flashes the wrong theme.
      (function () {
        function apply() {
          var root = document.documentElement;
          root.classList.add('js');
          try {
            var saved = localStorage.getItem('theme');
            if (saved === 'light' || saved === 'dark') root.setAttribute('data-theme', saved);
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <script>import '../scripts/motion.ts';</script>
  </head>
  <body>
    {header && <Header name={name} instagram={about?.data.instagram} />}
    <main><slot /></main>
    <Footer name={name} />
  </body>
</html>
