---
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string }
const about = await getEntry('about', 'about');
const name = about?.data.name ?? 'Tai Rong';
const { title, description = 'Travel photographs by ' + name + ', sorted by place.' } = Astro.props;
const pageTitle = title ? `${title} · ${name}` : name;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <Header name={name} instagram={about?.data.instagram} />
    <main><slot /></main>
    <Footer name={name} />
  </body>
</html>
