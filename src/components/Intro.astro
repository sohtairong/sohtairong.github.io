---
// Top of the home page: a full-width, slightly blurred travel photo with the menu above, the first
// sentence of your line in large type, and the *starred* part of it at the bottom right.
// Your portrait is in the About section; the intro sentence sits under “Where I’ve been”.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Header from './Header.astro';
import { dateLabel, featuredOf, type Trip } from '../lib/trips';
import { fontChoice, fontFaces, fontStyle, DEFAULT_HEADLINE_FONT, DEFAULT_LINE_FONT } from '../lib/fonts';

interface Props { about: CollectionEntry<'about'>; trips: Trip[] }
const { about, trips } = Astro.props;
const { headline, name, instagram } = about.data;

// The fonts chosen in Studio for the two lines.
const bigFont = fontChoice(about.data.headlineFont, DEFAULT_HEADLINE_FONT);
const smallFont = fontChoice(about.data.lineFont, DEFAULT_LINE_FONT);

// The hero photo: the one set in about.md, otherwise the newest trip's first featured photo.
const newest = trips[0];
const fallback = newest ? featuredOf(newest)[0] : undefined;
const hero = about.data.hero ?? fallback?.src;
const heroCaption = about.data.heroCaption
  ?? (about.data.hero ? undefined : fallback && newest ? [fallback.city || newest.data.country, dateLabel(newest)].join(', ') : undefined);

// The first part of the headline is the large line; the *starred* part is the smaller line.
const plainHeadline = headline.replace(/\*/g, '');
const starred = /\*(.+?)\*/.exec(headline);
const backWords = (starred ? headline.slice(0, starred.index) : headline).replace(/\*/g, '').trim();
const frontWords = starred ? starred[1].trim() : '';
const bigWords = backWords.split(/\s+/).filter(Boolean); // animated in one word at a time
---
<section class:list={['hero', { 'has-photo': hero }]}>
  {hero && (
    <div class="backdrop">
      <Image class="bg" src={hero} alt={heroCaption ? `Photograph: ${heroCaption}` : ''}
        widths={[960, 1600, 2400, 3000]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="scrim" aria-hidden="true"></div>
    </div>
  )}

  <Header name={name} instagram={instagram} />

  <style is:inline set:html={fontFaces(bigFont, smallFont)}></style>
  <div class="wrap"><div class="words">
    <h1 class="sr-only">{plainHeadline}</h1>
    {backWords && (
      <p class="big" style={fontStyle(bigFont)} aria-hidden="true">
        {bigWords.map((word, i) => <Fragment><span class="word" style={`--i:${i}`}>{word}</span>{' '}</Fragment>)}
      </p>
    )}
    {frontWords && <p class="small" style={`${fontStyle(smallFont)};--i:${bigWords.length}`} aria-hidden="true"><span>{frontWords}</span></p>}
  </div></div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    /* Sized by its content: enough top space to show the photo, no full-screen gap. */
  }
  /* Grid items with auto side margins shrink to fit; keep each row full width. */
  .hero > :global(*:not(.backdrop)) { width: 100%; }
  /* Over a photo, every colour token inside the hero flips to light. */
  .hero.has-photo {
    --tail: clamp(90px, 14vw, 180px);
    --ink: #ffffff;
    --ink-body: #ffffff;
    --ink-muted: rgba(255, 255, 255, 0.8);
    --rule: rgba(255, 255, 255, 0.32);
    color: var(--ink);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.3);
  }
  /* The photo and its shading. It runs a little past the bottom of the hero and fades out,
     so the photo melts into the page instead of ending in a hard line. */
  .backdrop {
    position: absolute; inset: 0 0 calc(var(--tail) * -1) 0; z-index: -1;
    overflow: clip; background: #2a2a28;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--tail) * 2.2), rgba(0, 0, 0, 0.78) calc(100% - var(--tail)), rgba(0, 0, 0, 0.3) calc(100% - var(--tail) * 0.4), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--tail) * 2.2), rgba(0, 0, 0, 0.78) calc(100% - var(--tail)), rgba(0, 0, 0, 0.3) calc(100% - var(--tail) * 0.4), transparent);
  }
  /* What follows the hero sits on top of the fading photo. */
  .hero.has-photo + :global(*) { position: relative; margin-top: calc(clamp(90px, 14vw, 180px) * 0.5); }
  /* A slight blur keeps the photo as atmosphere, so the words stay the subject.
     It is drawn a little larger than its box so the blur has no soft edges. */
  .bg {
    position: absolute; inset: -24px;
    width: calc(100% + 48px); height: calc(100% + 48px); max-width: none; object-fit: cover;
    filter: blur(7px);
  }
  /* The photo drifts slowly as you scroll away (only in browsers that support it, and not with reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .bg { animation: hero-drift linear both; }
      /* Kept as a separate rule on purpose: when the build merges the timeline into the line above, browsers ignore it. */
      .backdrop .bg { animation-timeline: scroll(root block); animation-range: 0 900px; }
    }
  }
  @keyframes hero-drift { to { transform: translateY(10%) scale(1.06); } }
  /* Darkens the photo where text sits so it stays readable on any image. */
  .has-photo .scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg,
      rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.18) 22%,
      rgba(0, 0, 0, 0.3) 50%, rgba(0, 0, 0, 0.72) 100%);
  }

  /* ---- The words: one large line, and a smaller one at the bottom right. Their fonts are chosen in Studio. ---- */
  .words { --big: clamp(54px, 10.6vw, 168px); display: grid; gap: clamp(28px, 7vh, 88px); padding-block: clamp(28px, 8vh, 96px) clamp(20px, 4vh, 44px); }
  .big {
    margin: 0; font-size: calc(var(--big) * var(--scale, 1)); line-height: 0.94; text-wrap: balance;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.28);
  }
  .small {
    margin: 0; justify-self: end; max-width: 15ch; text-align: right; text-wrap: balance;
    font-size: calc(clamp(20px, 2.9vw, 46px) * var(--scale, 1)); line-height: 1.04;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.4);
  }
  /* ---- Motion (never with reduced motion) ---- */
  @media (prefers-reduced-motion: no-preference) {
    /* Arriving: the large line comes into focus one word at a time, then the smaller line slides in. */
    .word { display: inline-block; animation: word-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(0.15s + var(--i) * 0.11s); }
    .small > span { display: inline-block; animation: line-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(0.45s + var(--i) * 0.11s); }
    /* Scrolling away: the two lines lift at different speeds and fade, so the words seem to float off the photo. */
    @supports (animation-timeline: scroll()) {
      .big { animation: big-away linear both; }
      .small { animation: small-away linear both; }
      /* Separate rule on purpose (see the note on the photo's drift above). */
      .words .big, .words .small { animation-timeline: scroll(root block); animation-range: 0 620px; }
    }
  }
  @keyframes word-in { from { opacity: 0; transform: translateY(0.38em) rotate(2deg); filter: blur(10px); } }
  @keyframes line-in { from { opacity: 0; transform: translateX(28px); filter: blur(6px); } }
  @keyframes big-away { to { transform: translateY(-70px); opacity: 0; filter: blur(6px); } }
  @keyframes small-away { to { transform: translateY(-150px); opacity: 0; } }

  @media (max-width: 720px) {
    .words { --big: 17vw; }
    .small { font-size: calc(7.4vw * var(--scale, 1)); max-width: 12ch; }
  }
</style>
