---
// The trip page's photo rhythm: one wide photo, then a pair, and so on.
// Override per photo with `layout: wide` or `layout: pair` in the trip's index.md.
import PhotoCard from './PhotoCard.astro';
import { rowsOf, type Trip } from '../lib/trips';
interface Props { trip: Trip }
const rows = rowsOf(Astro.props.trip);
---
<div class="wrap rows">
  {rows.map((row, i) =>
    row.length === 1 ? (
      <PhotoCard photo={row[0]} size="lg" showCity eager={i === 0}
        widths={[640, 960, 1600, 2400]} sizes="(min-width: 1320px) 1240px, calc(100vw - 32px)" />
    ) : (
      <div class="pair">
        {row.map((p) => (
          <PhotoCard photo={p} size="md" showCity
            widths={[480, 800, 1200]} sizes="(min-width: 1320px) 610px, (min-width: 720px) 50vw, calc(100vw - 32px)" />
        ))}
      </div>
    )
  )}
</div>

<style>
  .rows { display: grid; gap: 72px; padding-bottom: 72px; }
  .pair :global(img) { aspect-ratio: 4 / 5; object-fit: cover; }
  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; align-items: start; }
</style>
