---
interface Props { name: string }
const { name } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="wrap footer label">
  <span>© {year} {name}</span>
  <a href="#top">Back to top ↑</a>
</footer>

<style>
  .footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-block: 40px; text-transform: none; letter-spacing: 0; }
</style>
